# Optional. On Streamlit Cloud paste this into: App -> Settings -> Secrets.
# It connects an AI model for EVERY visitor, so they use YOUR key and quota.
# Leave it out and visitors can paste their own key in the Settings screen, or use basic mode.
LLM_PROVIDER = "openai"          # OpenAI-compatible: OpenAI, Gemini, Groq, OpenRouter...
LLM_API_KEY = "paste-key-here"
LLM_MODEL = "llama-3.3-70b-versatile"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
